[Unit]
Description=Apply end4-pC's generated KDE color scheme to Qt apps when it changes

[Path]
PathChanged=%h/.local/share/color-schemes/MaterialYouDark.colors
PathChanged=%h/.local/share/color-schemes/MaterialYouLight.colors
PathChanged=%h/.local/share/color-schemes/IllogicalNamed.colors

[Install]
WantedBy=default.target
