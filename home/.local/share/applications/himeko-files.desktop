[Desktop Entry]
Type=Application
Name=Himeko Files
GenericName=File Manager
Comment=Browse your files in the Himeko Glass style
Exec=@HOME@/.config/hypr/custom/himeko-files/himeko-files %u
Icon=system-file-manager
Terminal=false
Categories=System;FileTools;FileManager;
MimeType=inode/directory;
Keywords=folder;files;explorer;manager;
StartupNotify=false
